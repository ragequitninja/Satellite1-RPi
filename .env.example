# Copy this file to .env and adjust hosts for your environment.

# Default host for SSH deploy targets/scripts.
SAT1_HOST=pi@rasp0core2

# Optional SQ66-specific host override.
# For compatibility with sq66-* deploy flows.
SQ66_HOST=pi@rasp0core1

# XMOS firmware fetch defaults (for make xmos-firmware-*-from-gh targets).
XMOS_FW_REPO=FutureProofHomes/Satellite1-XMOS
XMOS_FW_ASSET=satellite_firmware_apps.zip
XMOS_FW_BIN=satellite1_firmware_fixed_delay.factory.bin
XMOS_FW_MD5=satellite1_firmware_fixed_delay.factory.md5
XMOS_FW_OUT_DIR=build-assets/xmos-fw-cache
